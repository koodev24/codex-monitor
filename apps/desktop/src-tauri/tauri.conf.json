{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodexMonitor",
  "version": "0.1.0",
  "identifier": "com.koodev24.codexmonitor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run fetch:sidecar && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Codex Account Monitor",
        "width": 980,
        "height": 460,
        "minWidth": 540,
        "minHeight": 320
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Monitor Codex API usage and quotas",
    "externalBin": ["binaries/codex"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/koodev24/codex-monitor/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVEREI2NTBDOTdGNjBFNkUKUldSdUR2YVhER1hiN2NSOGlvckF0RDM0QkZ4RUZEcUxyYWhvTFV5RE56VFJPNlE5WWZmdzNtRmkK"
    }
  }
}
